# Database (Vercel Postgres / any Postgres connection string)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated allow-list — restricts Google sign-in only (demo login is
# open to anyone by design, for a public try-it-out mode)
ALLOWED_EMAILS="you@gmail.com,friend@gmail.com"

# AI Assistant — real insight generation via Hugging Face's Inference Providers
# (free tier, get a token at huggingface.co/settings/tokens — it needs the
# "Make calls to Inference Providers" permission). Without it, or if HF is
# down / out of quota, the app writes a rule-based summary instead.
HF_API_TOKEN="hf_..."
# Optional: comma-separated models tried first. Default chain:
#   google/gemma-4-26B-A4B-it → google/gemma-4-31B-it → meta-llama/Llama-3.1-8B-Instruct
# (NOT google/gemma-4-E4B-it — no inference provider serves that one.)
# HF_MODEL="google/gemma-4-26B-A4B-it"

# Cross-platform price comparison — Serper.dev (Google Search API).
# Free tier: 2,500 one-time queries, no credit card. Get a key at serper.dev.
# Without this, single-URL scraping/insight still works; comparison across
# platforms and general seller discovery just won't run.
# Also used for Google Shopping prices, which is what keeps comparison working
# when stores block Vercel's datacenter IPs.
SERPER_API_KEY="your-serper-api-key"
# Optional: search locale (defaults to India / English)
# SERPER_GL="in"
# SERPER_HL="en"

# --- Scraping API for bot-walled stores (OPTIONAL, free tier is enough) ----
# Amazon/Croma block Vercel's datacenter IPs whatever browser you use; this
# routes blocked pages through India-based residential proxies. Leave unset
# and blocked pages just fall back to Google Shopping prices.
# Free key: sign up at scraperapi.com (no card) and paste it here — that's all.
# SCRAPING_API_KEY="..."
# SCRAPING_API_PROVIDER="scraperapi"   # default; or scrapedo | scrapfly | zenrows
# SCRAPING_API_PREMIUM=""              # unset = cheap request first, premium only if still blocked (saves credits)
#                                      # "0" = never premium, "1" = always premium
# SCRAPING_API_RENDER="1"              # provider-side JS rendering (more credits)
# SCRAPING_API_COUNTRY="in"

# --- JS rendering fallback (Lightpanda — no Chrome) -------------------------
# All optional. Plain fetch() is always tried first; these are only used when
# a page is JS-rendered or blocks plain requests. Pick any ONE (or none):
#
# 1) Spendora render server (scraper-server/ folder) on Hugging Face Spaces:
# SCRAPER_SERVER_URL="https://your-user-spendora-render.hf.space"
# SCRAPER_SERVER_TOKEN="same-secret-as-the-space"
#
# 2) Lightpanda Cloud (or any Lightpanda CDP endpoint):
# LIGHTPANDA_TOKEN="your-lightpanda-cloud-token"
# LIGHTPANDA_WS_URL="ws://127.0.0.1:9222"   # instead of the token, for self-hosted `lightpanda serve`
#
# 3) Local binary (VPS / Docker / local dev — not Vercel):
# LIGHTPANDA_EXECUTABLE_PATH="/usr/local/bin/lightpanda"
#
# BROWSER_RENDER="off"   # force-disable the render tier
