# Database (Vercel Postgres / any Postgres connection string)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated allow-list — restricts Google sign-in only (demo login is
# open to anyone by design, for a public try-it-out mode)
ALLOWED_EMAILS="you@gmail.com,friend@gmail.com"

# AI Assistant — real insight generation via Hugging Face's Inference Providers
# (free tier, get a token at huggingface.co/settings/tokens)
HF_API_TOKEN="hf_..."
# Optional override — defaults to a small Gemma 4 instruct model
# HF_MODEL="google/gemma-4-E4B-it"

# Cross-platform price comparison — Serper.dev (Google Search API).
# Free tier: 2,500 one-time queries, no credit card. Get a key at serper.dev.
# Without this, single-URL scraping/insight still works; comparison across
# platforms and general seller discovery just won't run.
SERPER_API_KEY="your-serper-api-key"
